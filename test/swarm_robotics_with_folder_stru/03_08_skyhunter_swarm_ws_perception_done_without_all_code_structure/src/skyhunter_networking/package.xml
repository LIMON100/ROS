<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skyhunter_networking</name>
  <version>0.1.0</version>
  <description>WiFi6 mesh simulation and swarm communication for skyhunter robots</description>
  <maintainer email="mohammedsrajk@gmail.com">Mohammed</maintainer>
  <license>MIT</license>


  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <!-- Python dependencies -->
  <depend>rclpy</depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Message package -->
  <depend>skyhunter_msgs</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
