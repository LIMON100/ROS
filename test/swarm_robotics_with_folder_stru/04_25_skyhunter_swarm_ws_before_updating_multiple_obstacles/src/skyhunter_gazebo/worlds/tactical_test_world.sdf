<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tactical_test_world">
    
    <!-- PHYSICS & CORE SYSTEMS -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.7 0.7 0.7 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- 1. THE BRICK FIELD (15cm height)           -->
    <!-- ========================================== -->
    <!-- These test low-profile obstacle detection -->
    <model name="brick_1">
      <pose>5.0 0.5 0.075 0 0 0.5</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.2 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.2 0.15</size></box></geometry><material><ambient>0.6 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <model name="brick_2">
      <pose>5.5 -0.8 0.075 0 0 -0.2</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.2 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.2 0.15</size></box></geometry><material><ambient>0.6 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <model name="brick_3">
      <pose>6.2 0.2 0.075 0 0 1.2</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.2 0.15</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.2 0.15</size></box></geometry><material><ambient>0.6 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- 2. THE TALL ELECTRIC POLES (8m height)     -->
    <!-- ========================================== -->
    <model name="electric_pole_1">
      <pose>15.0 4.0 4.0 0 0 0</pose>
      <static>true</static>
      <link name="pole">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>8.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>8.0</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <!-- The Cross-Arm -->
        <visual name="arm"><pose>0 0 3.5 0 1.57 0</pose><geometry><box><size>0.1 2.0 0.1</size></box></geometry></visual>
      </link>
    </model>

    <model name="electric_pole_2">
      <pose>30.0 -4.0 4.0 0 0 0</pose>
      <static>true</static>
      <link name="pole">
        <collision name="c"><geometry><cylinder><radius>0.15</radius><length>8.0</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>8.0</length></cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <visual name="arm"><pose>0 0 3.5 0 1.57 0</pose><geometry><box><size>0.1 2.0 0.1</size></box></geometry></visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- 3. CONCRETE BLOCKS (The Slalom)            -->
    <!-- ========================================== -->
    <model name="block_large_1">
      <pose>22.0 1.0 0.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>2 2 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 2 1</size></box></geometry><material><ambient>0.3 0.3 0.3 1</ambient></material></visual>
      </link>
    </model>

  </world>
</sdf>