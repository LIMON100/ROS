<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>skyhunter_perception</name>
  <version>0.0.0</version>
  <description>C++ perception nodes for the SkyHunter project.</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  
  <!-- Point Cloud & Grid Map -->
  <depend>pcl_conversions</depend>
  <depend>libpcl-all-dev</depend> <!-- Ensures PCL headers are found -->
  <depend>grid_map_ros</depend>
  <depend>grid_map_msgs</depend>
  <depend>libeigen3-dev</depend>

  <!-- TF2 Dependencies (Crucial for Transforms) -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_geometry_msgs</depend>

  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>