<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="agriculture_world">
    <!-- Add a light source -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose> <!-- Position the light high up in the sky -->
      <diffuse>0.9 0.9 0.9 1</diffuse>   <!-- Bright white light -->
      <specular>0.5 0.5 0.5 1</specular> <!-- Some shininess -->
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction> <!-- Angle the light like a morning/afternoon sun -->
    </light>

    <scene>
    <ambient>0.8 0.8 0.8 1.0</ambient> <!-- High ambient light -->
    <background>0.7 0.7 0.8 1.0</background> <!-- Light blue-grey sky -->
    <shadows>true</shadows>
    <sky>
      <time>10</time>
      <sunrise>6</sunrise>
      <sunset>20</sunset>
      <clouds>
        <speed>5</speed>
      </clouds>
    </sky>
    <!-- NO <fog> TAG - This removes the fog completely -->
  </scene>

    <!-- The main world terrain and barn -->
    <model name="agriculture_geometry">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="world_link">
        <visual name="visual">
          <origin xyz="0 0 0" rpy="0 0 3.14159"/>
          <geometry>
            <mesh>
              <!-- USE ABSOLUTE PATH -->
              <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/agriculture_world.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <origin xyz="0 0 0" rpy="0 0 3.14159"/>
          <geometry>
            <mesh>
              <!-- USE ABSOLUTE PATH -->
              <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/agriculture_world.dae</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- The base station accessory -->
    <model name="base_station">
        <static>true</static>
        <pose>-40 -17 0.7 0 0 0</pose>
        <link name="link">
            <visual name="visual">
                <geometry>
                    <mesh>
                        <!-- USE ABSOLUTE PATH -->
                        <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/BaseStationWithTripod.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <collision name="collision">
                <geometry>
                    <mesh>
                        <!-- USE ABSOLUTE PATH -->
                        <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/BaseStationWithTripod.dae</uri>
                    </mesh>
                </geometry>
            </collision>
        </link>
    </model>

    <!-- The charging dock accessory -->
    <model name="charge_dock">
        <static>true</static>
        <pose>8 -4 -0.2 0 0 1.5707</pose>
        <link name="link">
            <visual name="visual">
                <origin xyz="-0.35 0 0" rpy="0 0 1.5707"/>
                <geometry>
                    <mesh>
                        <!-- USE ABSOLUTE PATH -->
                        <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/WiboticTR301.dae</uri>
                    </mesh>
                </geometry>
            </visual>
            <collision name="collision">
                 <origin xyz="-0.35 0 0" rpy="0 0 1.5707"/>
                <geometry>
                    <mesh>
                        <!-- USE ABSOLUTE PATH -->
                        <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/WiboticTR301.dae</uri>
                    </mesh>
                </geometry>
            </collision>
        </link>
    </model>

    <include>
      <name>person_standing</name>
      <uri>model://person_standing</uri>
      <static>true</static>
      <pose>0 -2 0 0 0 0</pose>
    </include>

  </world>
</sdf>