<launch>
    <!-- Argument for the model file. In ROS 2, 'default' is used instead of 'default_value' -->
    <arg name="model" default="mogi_bot_mecanum.urdf" description="Name of the URDF description to load"/>

    <!-- Get the path to your package -->
    <let name="pkg_bme_gazebo_basics" value="$(find-pkg-share bme_gazebo_basics)"/>

    <!-- === 1. Start Gazebo Server === -->
    <executable cmd="gz sim -r $(var pkg_bme_gazebo_basics)/worlds/world.sdf" 
                output="screen" 
                shell="true"/>

    <!-- === 2. Spawn the Robot === -->
    <!-- Note: The '-file' argument is correct. We use a command substitution to build the full path. -->
    <node pkg="ros_gz_sim" exec="create"
          args="-file $(var pkg_bme_gazebo_basics)/urdf/$(var model) -name mogi_bot -x 0 -y 0 -z 0.5"
          output="screen"/>

    <!-- === 3. Publish Robot State & TF === -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var pkg_bme_gazebo_basics)/urdf/$(var model)')"/>
        <param name="use_sim_time" value="true"/>
    </node>
    
    <!-- === 4. Start the ROS-Gazebo Bridge === -->
    <!-- FIX: The arguments for the bridge must be in a single string, with each mapping separated by a space. -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock /cmd_vel@geometry_msgs/msg/Twist@gz.msgs.Twist /odom@nav_msgs/msg/Odometry@gz.msgs.Odometry /tf@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V /joint_states@sensor_msgs/msg/JointState[gz.msgs.Model"
        output="screen">
        <param name="use_sim_time" value="true"/>
    </node>

</launch>