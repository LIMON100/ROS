<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="agriculture_world">
    <!-- Add a light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- The main world terrain and barn -->
    <model name="agriculture_geometry">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="world_link">
        <visual name="visual">
          <origin xyz="0 0 0" rpy="0 0 3.14159"/>
          <geometry>
            <mesh>
              <!-- USE ABSOLUTE PATH -->
              <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/agriculture_world.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision">
          <origin xyz="0 0 0" rpy="0 0 3.14159"/>
          <geometry>
            <mesh>
              <!-- USE ABSOLUTE PATH -->
              <uri>/home/limonubuntu/Work/Limon/ros2_work/skyhunter_ws/src/skyhunter_gazebo/meshes/agriculture_world.dae</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- The base station accessory -->
    <model name="base_station">
