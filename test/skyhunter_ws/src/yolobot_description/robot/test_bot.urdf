<?xml version="1.0"?>
<robot name="agricultural_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Define materials -->
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  
  <material name="dark_gray">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>
  
  <material name="red">
    <color rgba="1 0 0 1"/>
  </material>
  
  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>

  <!-- Main body/chassis -->
  <link name="base_link">
    <inertial>
      <mass value="50"/>
      <inertia ixx="10" ixy="0" ixz="0" iyy="10" iyz="0" izz="10"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.8 0.5 0.25"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.8 0.5 0.25"/>
      </geometry>
    </collision>
  </link>
  
  <!-- Left track assembly with multiple wheels -->
  <link name="left_track_front">
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="left_track_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_track_front"/>
    <origin xyz="0.3 0.32 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <link name="left_track_middle">
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="left_track_middle_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_track_middle"/>
    <origin xyz="0 0.32 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <link name="left_track_rear">
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="left_track_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_track_rear"/>
    <origin xyz="-0.3 0.32 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <!-- Right track assembly with multiple wheels -->
  <link name="right_track_front">
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="right_track_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_track_front"/>
    <origin xyz="0.3 -0.32 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <link name="right_track_middle">
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="right_track_middle_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_track_middle"/>
    <origin xyz="0 -0.32 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <link name="right_track_rear">
    <inertial>
      <mass value="3"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.15" radius="0.12"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="right_track_rear_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_track_rear"/>
    <origin xyz="-0.3 -0.32 -0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  
  <!-- Track belts (visual only) -->
  <link name="left_track_belt">
    <visual>
      <origin xyz="0 0.32 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.05 0.25"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  
  <joint name="left_track_belt_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_track_belt"/>
  </joint>
  
  <link name="right_track_belt">
    <visual>
      <origin xyz="0 -0.32 -0.1" rpy="0 0 0"/>
      <geometry>
        <box size="0.7 0.05 0.25"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  
  <joint name="right_track_belt_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_track_belt"/>
  </joint>
  
  <!-- Sensor mast -->
  <link name="sensor_mast">
    <inertial>
      <mass value="2"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.12 0.12 0.4"/>
      </geometry>
      <material name="gray"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.12 0.12 0.4"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="sensor_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_mast"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
  </joint>
  
  <!-- LiDAR sensor at the top -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    
    <visual>
      <geometry>
        <cylinder length="0.12" radius="0.06"/>
      </geometry>
      <material name="red"/>
    </visual>
    
    <collision>
      <geometry>
        <cylinder length="0.12" radius="0.06"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="lidar_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.26" rpy="0 0 0"/>
  </joint>
  
  <!-- IMU sensor -->
  <link name="imu_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
      <material name="blue"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="imu_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="imu_link"/>
    <origin xyz="0.06 0 0.2" rpy="0 0 0"/>
  </joint>
  
  <!-- GPS sensor -->
  <link name="gps_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.06 0.06 0.03"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="gps_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="gps_link"/>
    <origin xyz="-0.06 0 0.2" rpy="0 0 0"/>
  </joint>
  
  <!-- STEREO CAMERA MOUNT - positioned below LIDAR -->
  <link name="stereo_camera_mount">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    
    <visual>
      <geometry>
        <box size="0.25 0.08 0.04"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.25 0.08 0.04"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="stereo_camera_mount_joint" type="fixed">
    <parent link="sensor_mast"/>
    <child link="stereo_camera_mount"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  
  <!-- LEFT CAMERA - positioned side-by-side horizontally -->
  <link name="left_camera_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    
    <!-- Camera body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Camera lens - clearly visible -->
    <visual>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="left_camera_joint" type="fixed">
    <parent link="stereo_camera_mount"/>
    <child link="left_camera_link"/>
    <origin xyz="-0.08 0 0.02" rpy="0 0 0"/>
  </joint>
  
  <!-- RIGHT CAMERA - positioned side-by-side horizontally -->
  <link name="right_camera_link">
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    
    <!-- Camera body -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <!-- Camera lens - clearly visible -->
    <visual>
      <origin xyz="0.03 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.02"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    
    <collision>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="right_camera_joint" type="fixed">
    <parent link="stereo_camera_mount"/>
    <child link="right_camera_link"/>
    <origin xyz="0.08 0 0.02" rpy="0 0 0"/>
  </joint>
  
  <!-- Gazebo plugins for sensors -->
  <gazebo>
    <plugin name="imu_plugin" filename="libgazebo_ros_imu.so">
      <robotNamespace>/</robotNamespace>
      <topicName>imu/data</topicName>
      <serviceName>imu/service</serviceName>
      <bodyName>imu_link</bodyName>
      <gaussianNoise>0.0</gaussianNoise>
      <updateRate>50.0</updateRate>
    </plugin>
  </gazebo>
  
  <gazebo>
    <plugin name="gps_plugin" filename="libhector_gazebo_ros_gps.so">
      <robotNamespace>/</robotNamespace>
      <topicName>gps/fix</topicName>
      <referenceLatitude>49.9</referenceLatitude>
      <referenceLongitude>8.9</referenceLongitude>
      <referenceAltitude>0</referenceAltitude>
      <updateRate>10</updateRate>
    </plugin>
  </gazebo>
  
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>lidar_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  
  <gazebo reference="left_camera_link">
    <sensor type="camera" name="left_camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="left_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin name="left_camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>left_camera</cameraName>
        <imageTopicName>/left_camera/image_raw</imageTopicName>
        <cameraInfoTopicName>/left_camera/camera_info</cameraInfoTopicName>
        <frameName>left_camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  
  <gazebo reference="right_camera_link">
    <sensor type="camera" name="right_camera_sensor">
      <update_rate>30.0</update_rate>
      <camera name="right_camera">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
      </camera>
      <plugin name="right_camera_controller" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>right_camera</cameraName>
        <imageTopicName>/right_camera/image_raw</imageTopicName>
        <cameraInfoTopicName>/right_camera/camera_info</cameraInfoTopicName>
        <frameName>right_camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
  
  <!-- Differential drive plugin for the tracks -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <alwaysOn>true</alwaysOn>
      <updateRate>20</updateRate>
      <leftJoint>left_track_front_joint</leftJoint>
      <rightJoint>right_track_front_joint</rightJoint>
      <wheelSeparation>0.64</wheelSeparation>
      <wheelDiameter>0.24</wheelDiameter>
      <torque>20</torque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
    </plugin>
  </gazebo>

</robot>