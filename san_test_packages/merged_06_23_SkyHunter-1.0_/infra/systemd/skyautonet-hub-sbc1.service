# SAN v1.5.2 — DCN-2026-011 D-035 Hub UGV SBC #1 systemd unit.
#
# Installed by infra/systemd/install.sh after the operator selects the
# "hub-sbc1" role. Companion of skyautonet-hub-sbc2.service on the
# peer board. Calls the san_bringup hub_sbc1.launch.py wrapper which
# pins robot_id=2 / robot_role=hub / sbc_id=1 / hub_features=true.

[Unit]
Description=SkyAutoNet Hub UGV SBC #1 (DCN-2026-011 D-035)
Documentation=https://github.com/adasone/SH_Unitree_Patrol/blob/main/infra/systemd/README.md
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target

[Service]
Type=simple
User=skyautonet
Group=skyautonet
WorkingDirectory=/opt/skyautonet
Environment="ROS_DOMAIN_ID=42"
# DCN-2026-014 D-050: swarm-wide migration to FastDDS.
Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
Environment="FASTRTPS_DEFAULT_PROFILES_FILE=/opt/skyautonet/share/san_bringup/config/fastrtps_profile.xml"
Environment="HOME=/home/skyautonet"
# DCN-2026-014 Item 8: static mesh0 IP (EasyMesh deterministic mapping).
# C++ executable from san_bringup, symlinked by install.sh.
ExecStartPre=/usr/local/sbin/network_bringup
ExecStart=/bin/bash -c 'source /opt/skyautonet/install/setup.bash && \
                       exec ros2 launch san_bringup hub_sbc1.launch.xml \
                            deployment_mode:=production'
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skyautonet-hub-sbc1

# Resource limits — RK3588 has 8 GB RAM; leave 1 GB for OS.
MemoryMax=7G
TasksMax=4096

[Install]
WantedBy=multi-user.target
