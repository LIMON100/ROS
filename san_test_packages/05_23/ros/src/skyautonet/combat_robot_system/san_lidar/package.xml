<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>san_lidar</name>
  <version>1.5.0</version>
  <description>
    SAN v1.5 — Robosense E1 driver shim + RANSAC ground-plane
    segmentation + single-point LRF driver (Phase 2-E Turn 7).
    Republishes the upstream rslidar_sdk cloud as a ground/obstacle
    pair plus a ground-slope scalar for san_costmap. Adds lrf_node
    for narrow-beam range queries.
  </description>
  <maintainer email="dev@skyautonet.com">SkyAutoNet</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>combat_robot_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>libpcl-all-dev</depend>

  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
