<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>combat_robot_launch</name>
  <version>1.3.0</version>
  <description>
    SAN v1.3 PHASE 0 — top-level launch package. Selects the params
    overlay yaml from the resolved deployment_mode and brings up the
    operation_system + swarm_coordinator stack.
  </description>
  <maintainer email="dev@skyautonet.com">SkyAutoNet</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>combat_robot_operation_system</exec_depend>
  <exec_depend>swarm_coordinator</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
