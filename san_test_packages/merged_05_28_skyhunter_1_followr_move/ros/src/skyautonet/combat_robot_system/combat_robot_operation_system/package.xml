<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>combat_robot_operation_system</name>
  <version>1.3.0</version>
  <description>
    SAN v1.3 PHASE 0 - 5-tier deployment_mode resolution + 8-robot
    ID mapping. Owns the DEVELOPER_AUTH_TOKEN enforcement and the
    OperationState 1 Hz heartbeat.
  </description>
  <maintainer email="dev@skyautonet.com">SkyAutoNet</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>combat_robot_msgs</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
