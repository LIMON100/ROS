<?xml version="1.0"?>
<!-- SAN v1.3 PHASE 1 - san_costmap (cost_map_node). -->
<launch>
    <arg name="config_file"
         default="$(find-pkg-share san_costmap)/config/nav2_costmap.yaml"/>
    <arg name="robot_id" default="0"/>

    <node pkg="san_costmap" exec="cost_map_node"
          name="cost_map_node" output="screen">
        <param from="$(var config_file)"/>
        <param name="robot_id" value="$(var robot_id)"/>
    </node>
</launch>
