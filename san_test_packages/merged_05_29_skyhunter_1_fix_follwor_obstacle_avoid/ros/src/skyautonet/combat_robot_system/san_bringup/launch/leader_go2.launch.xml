<?xml version="1.0"?>
<!--
  Leader (Unitree Go2) — fixed-role launch wrapper (DCN-2026-011 D-034).
  Converted from leader_go2.launch.py per DCN-2026-014 (C++/XML policy);
  the .py version is preserved under launch/deprecated/ for archive.

  Equivalent to:
    ros2 launch san_bringup squadron.launch.xml \
        robot_id:=1 robot_role:=leader sbc_id:=0 \
        hub_features:=false include_regression:=auto

  Pin reasoning:
    - robot_id=1, robot_role=leader : Leader slot in the v1.5 IDS topology
    - sbc_id=0                      : "N/A" sentinel — Leader is single-SBC,
                                      not the dual-SBC redundancy of the Hub
    - hub_features=false            : explicit; hub-only group stays disabled
-->
<launch>
  <arg name="deployment_mode"    default="production"
       description="production | demo | lab_test | bench | development"/>
  <arg name="include_regression" default="auto"
       description="auto | true | false"/>
  <arg name="use_sim_time"       default="false"/>
  <!-- DCN-2026-012 v2 D-043 passthrough -->
  <arg name="sim_startup_offset_sec" default="5.0"
       description="DCN-2026-012 v2 D-043: per-robot sim startup stagger"/>

  <log message="[leader_go2] Launching Leader (Unitree Go2) profile"/>

  <include file="$(find-pkg-share san_bringup)/launch/squadron.launch.xml">
    <arg name="robot_id"               value="1"/>
    <arg name="robot_role"             value="leader"/>
    <arg name="sbc_id"                 value="0"/>
    <arg name="hub_features"           value="false"/>
    <arg name="include_regression"     value="$(var include_regression)"/>
    <arg name="deployment_mode"        value="$(var deployment_mode)"/>
    <arg name="use_sim_time"           value="$(var use_sim_time)"/>
    <arg name="sim_startup_offset_sec" value="$(var sim_startup_offset_sec)"/>
  </include>
</launch>
