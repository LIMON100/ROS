<!--
  [DCN-2026-016] Gate-1 demo bring-up.

  Composes operation_control_node (DEMO mode by default) with the
  san_rth /rth action server so /gate1/start_demo + /emergency_stop +
  60-sec watchdog all have a working RTH fallback target.
-->
<launch>
  <arg name="use_sim_time"   default="false"/>
  <arg name="deployment_mode" default="demo"
       description="One of {demo, lab_test}. Other modes will reject
                    /gate1/start_demo at service-call time."/>
  <arg name="robot_id"       default="1"/>

  <node pkg="san_operation_control" exec="operation_control_node"
        name="operation_control_node" output="screen">
    <param name="use_sim_time"     value="$(var use_sim_time)"/>
    <param name="deployment_mode"  value="$(var deployment_mode)"/>
    <param name="robot_id"         value="$(var robot_id)"/>
  </node>

  <include file="$(find-pkg-share san_rth)/launch/rth.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
  </include>
</launch>
