# SAN v1.5.2 — DCN-2026-011 D-035 Follower UGV systemd unit.
#
# Default robot_id = 4 (lowest follower slot). Operators provisioning
# followers 5/6/7/8 set ROBOT_ID via an EnvironmentFile drop-in, e.g.:
#
#   /etc/systemd/system/skyautonet-follower.service.d/robot_id.conf
#     [Service]
#     Environment="ROBOT_ID=5"
#
# The ExecStart picks up ${ROBOT_ID} via shell expansion.

[Unit]
Description=SkyAutoNet Follower UGV (DCN-2026-011 D-035)
Documentation=https://github.com/adasone/SH_Unitree_Patrol/blob/main/infra/systemd/README.md
After=network-online.target NetworkManager-wait-online.service
Wants=network-online.target

[Service]
Type=simple
User=skyautonet
Group=skyautonet
WorkingDirectory=/opt/skyautonet
Environment="ROBOT_ID=4"
Environment="ROS_DOMAIN_ID=42"
# DCN-2026-014 D-050: swarm-wide migration to FastDDS.
Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
Environment="FASTRTPS_DEFAULT_PROFILES_FILE=/opt/skyautonet/share/san_bringup/config/fastrtps_profile.xml"
Environment="HOME=/home/skyautonet"
# DCN-2026-014 Item 8: static mesh0 IP (EasyMesh deterministic mapping).
# C++ executable from san_bringup, symlinked by install.sh.
# Reads /etc/skyautonet/{robot_id,sbc_id} — install.sh writes the
# follower's robot_id (4-8) per operator selection alongside the
# matching systemd ROBOT_ID Environment.
ExecStartPre=/usr/local/sbin/network_bringup
ExecStart=/bin/bash -c 'source /opt/skyautonet/install/setup.bash && \
                       exec ros2 launch san_bringup follower.launch.xml \
                            robot_id:=${ROBOT_ID} \
                            deployment_mode:=production'
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skyautonet-follower

MemoryMax=7G
TasksMax=4096

[Install]
WantedBy=multi-user.target
