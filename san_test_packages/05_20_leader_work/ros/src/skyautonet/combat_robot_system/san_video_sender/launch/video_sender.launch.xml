<?xml version="1.0"?>
<!-- SAN v1.3 PHASE 5 - follower video sender. -->
<launch>
    <arg name="robot_id" default="3"/>
    <arg name="hub_ip"   default="10.0.0.2"/>
    <arg name="codec"    default="h265"/>
    <arg name="config_file"
         default="$(find-pkg-share san_video_sender)/config/video_sender.yaml"/>

    <node pkg="san_video_sender" exec="video_sender_node"
          name="video_sender_node" output="screen">
        <param from="$(var config_file)"/>
        <param name="robot_id" value="$(var robot_id)"/>
        <param name="hub_ip"   value="$(var hub_ip)"/>
        <param name="codec"    value="$(var codec)"/>
    </node>
</launch>
