# batman-adv per-mesh tuning. SDD §5 calls for BATMAN V (RFC 7184
# variant) and a 1 s OGM interval for fast topology convergence.

config mesh 'bat0'
    option routing_algo 'BATMAN_V'
    option orig_interval '1000'      # ms — OGM broadcast cadence
    option hop_penalty '15'          # discourages long paths
    option distributed_arp_table '1'
    option fragmentation '1'
    option bridge_loop_avoidance '1'
    option multicast_mode '1'        # IGMP-snooping aware
    option network_coding '0'        # disabled — increases jitter
    option gw_mode 'off'             # mesh is symmetric, no gateway
    option aggregated_ogms '1'
    option log_level '0'
