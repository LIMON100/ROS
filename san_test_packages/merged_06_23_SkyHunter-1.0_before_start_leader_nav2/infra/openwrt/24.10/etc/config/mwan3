# mwan3 — multi-WAN policy. Primary = eth WAN, fallback = LTE.
# `wan` always preferred; `wan_lte` takes over on tracking failure.

config globals 'globals'
    option mmx_mask '0x3F00'
    option local_source 'lan'

config interface 'wan'
    option enabled '1'
    list track_ip '1.1.1.1'
    list track_ip '8.8.8.8'
    option track_method 'ping'
    option reliability '1'
    option count '2'
    option timeout '2'
    option interval '5'
    option down '3'
    option up '5'

config interface 'wan_lte'
    option enabled '1'
    list track_ip '1.1.1.1'
    option track_method 'ping'
    option reliability '1'
    option count '2'
    option timeout '3'
    option interval '10'
    option down '3'
    option up '5'

config member 'wan_m1_w3'
    option interface 'wan'
    option metric '1'
    option weight '3'

config member 'wan_lte_m2_w1'
    option interface 'wan_lte'
    option metric '2'
    option weight '1'

config policy 'wan_then_lte'
    list use_member 'wan_m1_w3'
    list use_member 'wan_lte_m2_w1'
    option last_resort 'unreachable'

config rule 'default_rule'
    option dest_ip '0.0.0.0/0'
    option use_policy 'wan_then_lte'
