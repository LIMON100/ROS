<?xml version="1.0"?>
<!-- SAN v1.3 PHASE 3 - Hub UGV SBC #1 SLAM aggregator. -->
<launch>
    <arg name="config_file"
         default="$(find-pkg-share san_hub_slam)/config/hub_slam.yaml"/>

    <node pkg="san_hub_slam" exec="hub_slam_node"
          name="hub_slam_node" output="screen">
        <param from="$(var config_file)"/>
    </node>
</launch>
