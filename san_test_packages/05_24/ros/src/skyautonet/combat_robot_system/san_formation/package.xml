<?xml version="1.0"?>
<package format="3">
  <name>san_formation</name>
  <version>1.5.0</version>
  <description>
    SAN v1.5 — 9 Formations + Hungarian slot assignment (SDD-SWARM §7).
    Publishes SlotAssignment, FollowerTargetMessage (KPP-1, KPP-3),
    FormationStatus per IDS-CMD v1.5 §4.2/§5.1/§5.9.
  </description>
  <maintainer email="taegeun.kim@skyautonet.com">Kim Taegeun</maintainer>
  <license>Proprietary - SkyAutoNet</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>combat_robot_msgs</depend>

  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
