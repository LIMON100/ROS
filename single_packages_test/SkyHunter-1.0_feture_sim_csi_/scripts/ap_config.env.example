# Copy to scripts/ap_config.env and tune for your robot.
# scripts/ap_config.env is gitignored; this .example file is the template.
#
# All values are optional — start_ap.sh has sensible defaults — but you
# almost certainly want to override AP_PASSPHRASE at minimum.

# Broadcast SSID. Consider including robot_id so multiple robots in the
# same area are distinguishable.
# AP_SSID="CombatRobot-1"

# WPA2-PSK passphrase. MUST be 8-63 ASCII characters. CHANGE THE DEFAULT.
# AP_PASSPHRASE="change-me-12345678"

# 2.4 GHz channel (1-13). 1 / 6 / 11 are non-overlapping in most regulatory
# domains and are safe defaults.
# AP_CHANNEL=6

# 802.11 country code (ISO 3166-1 alpha-2). Some drivers refuse to start
# without it, especially on 5 GHz. Default KR (South Korea).
# AP_COUNTRY=KR

# IP address assigned to the AP interface and the /24 it serves.
# AP_IP=192.168.50.1
# AP_DHCP_START=192.168.50.10
# AP_DHCP_END=192.168.50.50

# WLAN interface to use. Auto-detected via iw dev / ip link if empty.
# WLAN_IFACE=wlan0
