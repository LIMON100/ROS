<?xml version="1.0" encoding="UTF-8"?>
<!--
  FastDDS (rmw_fastrtps_cpp) 전송 프로파일
  ========================================
  목적: CycloneDDS 의 <SocketReceiveBufferSize> 튜닝을 FastDDS 로 이식한다.

  배경 / 왜 필요한가:
    - LiDAR(/rslidar_points, PointCloud2, BestEffort, 10Hz) 한 프레임은 수백 KB~1MB.
    - FastDDS UDP transport 의 send/receiveBufferSize 기본값은 0 = "OS 기본값 사용"
      이며, OS 기본값은 net.core.rmem_default(208KB) 를 따른다.
      net.core.rmem_max(천장) 가 아무리 커도 FastDDS 가 자동으로 그 천장까지
      잡아주지 않는다.
    - 208KB 버퍼로는 10Hz 포인트클라우드 버스트에서 단편(fragment)이 넘쳐 손실되고,
      BestEffort 라 재전송이 없어 그대로 프레임 드롭 -> 실효 10Hz->3Hz 저하.
    - 따라서 socket buffer 를 명시적으로 16MB 로 요청해야 한다.
      (커널 net.core.rmem_max/wmem_max 가 이보다 커야 실제로 반영된다.
       scripts/sysctl/60-dds-socket-buffers.conf 참조.)

  사용법 (ROS2 Humble):
    export FASTRTPS_DEFAULT_PROFILES_FILE=/abs/path/scripts/fastdds_profile.xml
    export RMW_IMPLEMENTATION=rmw_fastrtps_cpp   # Humble 기본값이므로 보통 생략 가능
    # 이후 ros2 launch / run 하면 이 프로파일이 모든 participant 에 적용된다.

  검증:
    ros2 topic hz /rslidar_points   # 10Hz 안정 유지되는지 확인
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <profiles>

    <!-- 큰 UDP 소켓 버퍼를 가진 전송 디스크립터 -->
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>big_buffer_udp</transport_id>
        <type>UDPv4</type>
        <!-- 16MB. 커널 net.core.rmem_max/wmem_max(>=16MB) 가 천장이 된다. -->
        <sendBufferSize>16777216</sendBufferSize>
        <receiveBufferSize>16777216</receiveBufferSize>
        <!-- UDP 단편화 임계값. CycloneDDS <MaxMessageSize>65500B</> 와 동일 의도. -->
        <maxMessageSize>65500</maxMessageSize>
        <maxInitialPeersRange>10</maxInitialPeersRange>
        <!--
          interfaceWhiteList: 이 호스트(operator, skyauto-csi)의 WiFi(wlp3s0) 주소만
          DDS locator 로 광고/사용한다. docker0(172.17.0.1)가 함께 광고되면 차량(humble)이
          reliable /tf 의 ACK/heartbeat 를 도달 불가한 172.17.x 로 보내 고빈도 TF/tf_static
          전달이 깨진다(저빈도 /fix 는 통과). docker0 간섭 제거용.
          주: DHCP 주소라 IP 변경 시 갱신 필요. (백업: fastdds_profile.xml.bak)
        -->
        <interfaceWhiteList>
          <address>127.0.0.1</address>
          <address>172.16.30.164</address>
        </interfaceWhiteList>
      </transport_descriptor>

      <!-- 같은 보드 내 노드 간 통신용 공유메모리(SHM): 소켓 버퍼를 아예 우회.
           카메라/라이다/nav2 가 한 보드(RK3588)에 있으면 큰 이득.
           멀티 로봇(보드 간) 통신은 위 UDP 로 빠진다. -->
      <transport_descriptor>
        <transport_id>shm_local</transport_id>
        <type>SHM</type>
        <segment_size>33554432</segment_size> <!-- 32MB 공유 세그먼트 -->
      </transport_descriptor>
    </transport_descriptors>

    <!-- 모든 participant 가 위 전송을 쓰도록 기본 프로파일로 지정 -->
    <participant profile_name="default_big_buffer" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_local</transport_id>
          <transport_id>big_buffer_udp</transport_id>
        </userTransports>
        <!-- 기본 builtin transport 를 끄고 위에서 정의한 것만 사용 -->
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>

  </profiles>
</dds>
