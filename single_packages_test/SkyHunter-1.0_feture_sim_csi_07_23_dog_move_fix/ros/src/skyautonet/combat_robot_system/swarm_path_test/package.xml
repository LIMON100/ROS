<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swarm_path_test</name>
  <version>0.0.1</version>
  <description>호스트에서 차량 nav2(mission_control)로 /swarm/path_command(SwarmPathCommand)를 발행해 주행을 테스트하는 C++ 도구 (태블릿 흉내).</description>
  <maintainer email="skyauto.admin@gmail.com">skyauto</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>combat_robot_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
