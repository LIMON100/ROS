<launch>
    <arg name="use_operator" default="false"/>
    <arg name="use_detector" default="true"/>
    <arg name="use_sensor" default="false"/>
    <arg name="use_visualization" default="false"/>
    <arg name="use_controller" default="false"/>
    <arg name="use_camera_motor" default="false"/>
    <arg name="use_robot_server" default="true"/>
    <arg name="use_teleop" default="false"/>
    <arg name="use_trigger" default="false"/>
    <!-- Detection Package -->
    <group if="$(var use_detector)">
      <include file="$(find-pkg-share camera_interface)/launch/camera_driver.launch.xml"> </include>
      <!-- <include file="$(find-pkg-share camera_interface)/launch/zoom_controller.launch.xml"> </include> -->      
      <include file="$(find-pkg-share human_detector)/launch/human_detector.launch.xml"> </include>
      <!-- Added camera_ros camera_node launch -->
      <!-- <node pkg="camera_ros" exec="camera_node" name="camera_node" output="screen">
        <param name="format" value="RGB888"/>
        <param name="width" value="640"/>
        <param name="height" value="640"/>
        <param name="sensor_mode" value="1332:990"/>
        <param name="FrameDurationLimits" value="[10000,10000]"/>
      </node> -->
    </group>
    
    <!-- Operator Package -->
    <group if="$(var use_operator)">
      <include file="$(find-pkg-share pan_tilt_controller)/launch/pan_tilt_controller.launch.xml"> </include>
      <include file="$(find-pkg-share combat_robot_operation_system)/launch/combat_robot_operation_system.launch.xml"> </include>
    </group>

    <!-- Sensor Packages -->
    <group if="$(var use_sensor)">
      <include file="$(find-pkg-share laser_distance)/launch/laser_distance.launch.xml" />
      <!--<include file="$(find-pkg-share imu_publisher)/launch/imu_launch.py" />-->
    </group>

    <!-- Visualization Packages -->
    <group if="$(var use_visualization)">
      <include file="$(find-pkg-share display)/launch/display.launch.xml" />
    </group>

    <!-- BLE Command Node -->



    <!-- Camera Motor Packages -->
    <group if="$(var use_camera_motor)">
      <include file="$(find-pkg-share camera_interface)/launch/zoom_controller.launch.xml"> </include>
    </group>

    <!-- RTSP Packages -->
    <group if="$(var use_robot_server)">
      <include file="$(find-pkg-share robot_server)/launch/command_server.launch.xml"> </include>
      <include file="$(find-pkg-share robot_server)/launch/rtsp_server.launch.xml"> </include>
    </group>

    <!-- teleop Packages -->
    <group if="$(var use_teleop)">
      <include file="$(find-pkg-share teleop_controller)/launch/teleop_controller.launch.xml"> </include>
    </group>

      <!-- trigger Packages -->
    <group if="$(var use_trigger)">
      <include file="$(find-pkg-share gun_trigger)/launch/gun_trigger.launch.xml"> </include>
    </group>
</launch>
    
