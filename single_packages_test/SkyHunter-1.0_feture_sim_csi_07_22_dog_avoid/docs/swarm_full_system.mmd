%% Combat Robot — 전체 타깃 시스템 (명령 경로 + 상태 수집 통합)
%% 모든 로봇이 동일 스택. 차이는 정적 robot_id 와 command_server role 하나뿐.
%% 🔵 명령 bus(하향): 태블릿→리더 command_server→글로벌 발행→모든 로봇→로컬 cmd→FSM 게이트→executor→nav2
%% 🟠 상태 bus(상향): 각 로봇 coordinator→/swarm/robot_status(id)→리더 command_server 1개 구독→SwarmStatusPacket→태블릿
flowchart TB
    Tablet["📱 태블릿/앱 (리더에만 연결)"]

    CMDBUS{{"⬇ 명령 bus (리더 command_server 발행)<br/>/swarm/path_command · /mission_control_command · /swarm/control_command<br/>mesh · reliable + transient_local"}}
    STATBUS{{"⬆ 상태 bus (모든 로봇 발행)<br/>/swarm/robot_status (robot_id로 식별)<br/>mesh · reliable · keep_last≥N"}}

    subgraph S1["로봇 S1 — 리더 · robot_id=1 (정적)"]
        direction TB
        LCMD["command_server (role=leader)"]
        LFSM["FSM (모드/상태/게이트)"]
        LEXE["swarm_path_executor slot=f(1)<br/>파싱+편대변형+GPS→map+nav2 goal+상태"]
        LNAV["nav2"]
        LCOORD["swarm_coordinator<br/>status통합/heartbeat/리더선출"]
    end

    subgraph SN["로봇 Sn — 팔로워 · robot_id=n · 동일 스택 (n=2..N)"]
        direction TB
        FCMD["command_server (role=follower)"]
        FFSM["FSM (모드/상태/게이트)"]
        FEXE["swarm_path_executor slot=f(n)"]
        FNAV["nav2"]
        FCOORD["swarm_coordinator<br/>status통합/heartbeat"]
    end

    %% ===== 명령 경로 (하향) =====
    Tablet -- "TCP/UDP" --> LCMD
    LCMD -- "글로벌 발행" --> CMDBUS
    CMDBUS -- "구독" --> FCMD
    LCMD -- "/s1/cmd" --> LFSM
    LCMD --> LEXE
    FCMD -- "/sn/cmd" --> FFSM
    FCMD --> FEXE
    LFSM -- "게이트" --> LEXE
    FFSM -- "게이트" --> FEXE
    LEXE -- "NavigateToPose" --> LNAV
    FEXE -- "NavigateToPose" --> FNAV

    %% ===== 상태 경로 (상향) =====
    LEXE -. "/s1/swarm/mission_state" .-> LFSM
    FEXE -. "/sn/swarm/mission_state" .-> FFSM
    LFSM -. "로컬상태" .-> LCOORD
    LEXE -. "로컬상태" .-> LCOORD
    FFSM -. "로컬상태" .-> FCOORD
    FEXE -. "로컬상태" .-> FCOORD
    LCOORD -- "SwarmRobotStatus(id=1)" --> STATBUS
    FCOORD -- "SwarmRobotStatus(id=n)" --> STATBUS
    STATBUS -- "구독 1개, id 라우팅" --> LCMD
    LCMD -- "SwarmStatusPacket" --> Tablet

    %% ===== 페일오버 =====
    FCOORD -. "heartbeat" .-> LCOORD
    LCOORD -. "리더 부재 시 role 플립(정적 우선순위)" .-> FCMD

    classDef exe fill:#fff3b0,stroke:#e0a800,stroke-width:2px;
    classDef cmdbus fill:#cfe8ff,stroke:#1c6fb3,stroke-width:2px;
    classDef statbus fill:#ffd9c0,stroke:#cc6a2b,stroke-width:2px;
    classDef cmd fill:#d8f5d8,stroke:#2f8f2f,stroke-width:2px;
    class LEXE,FEXE exe;
    class CMDBUS cmdbus;
    class STATBUS statbus;
    class LCMD,FCMD cmd;
