<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="gauntlet_world">
    <!-- Geodetic origin — REQUIRED for the NavSat (GPS) sensor. Without it
         gz defaults to lat/lon (0,0), which is the equator + prime-meridian
         UTM zone 30/31 boundary: GPS noise then flips the UTM zone every
         fix (easting jumps ~668 km, 833977 <-> 166023), diverging the
         global EKF and producing a garbage map->odom (millions of metres).
         Use a valid non-boundary site (Korea, UTM zone 52N) — matches
         empty_world.sdf. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>36.61002559225</latitude_deg>
      <longitude_deg>127.28772570583</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- PHYSICS & CORE SYSTEMS -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.7 0.7 0.7 1</background><shadows>true</shadows></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry><material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- 12 TALL ELECTRIC POLES (RIGHT SIDE)        -->
    <!-- ========================================== -->
    <model name="p1"><pose>12 -4 4 0 0 0</pose><static>1</static><link name="l"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.12</radius><length>8</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient></material></visual></link></model>
    <model name="p2"><pose>15 -10 4 0 0 0</pose><static>1</static><link name="l"><collision name="c"><geometry><cylinder><radius>0.12</radius><length>8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.12</radius><length>8</length></cylinder></geometry></visual></link></model>
