<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pan_tilt_controller</name>
  <version>0.0.0</version>
  <description>Pan/Tilt Controller: Driver and controller for the pan/tilt mechanism using serial communication.</description>
  <maintainer email="kijong.gong@skyautonet.com">sky</maintainer>
  <license>SkyAutoNet Commercial License</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  
  <depend>std_msgs</depend>
  <depend>combat_robot_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
