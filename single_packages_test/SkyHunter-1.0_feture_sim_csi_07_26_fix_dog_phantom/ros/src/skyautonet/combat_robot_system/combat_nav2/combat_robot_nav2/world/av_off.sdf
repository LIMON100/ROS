<?xml version="1.0"?>
<!-- ===================================================================== -->
<!-- POC RUNWAY WORLD  (GENERATED by scripts/generate_runway_world.py)      -->
<!-- 권원: POC 활주로 시나리오 26m x 400m, 5단계 (Requirement 1+2).         -->
<!-- Local ENU: x=drive 0..400m runway, y=width +/-13m (y=0                 -->
<!-- centreline=GO2 path). START LINE x=50 (green), goal flag (350,0) —     -->
<!-- drive 300 m; obstacles x[80,230],|y|<=11.                              -->
<!-- Header (physics/plugins/spherical_coordinates) reused from             -->
<!-- empty_world.sdf VERBATIM so GPS/NavSat/sensors behave identically.     -->
<!-- DO NOT hand-edit: regenerate via the generator.                        -->
<!-- ===================================================================== -->
<sdf version="1.8">
  <world name="av_clear">

    <!-- POC v6.2: run FASTER THAN REAL TIME. real_time_factor=0 +
         real_time_update_rate=0 already remove every throttle, so gz steps as
         fast as the CPU allows — on a slow WSL2 /mnt/c host that is only
         RTF≈0.57, and it CANNOT be raised by "setting RTF=1" (nothing is
         capping it; the machine is compute-bound below 1.0). The one lever that
         raises the ACHIEVED RTF is the physics step: max_step_size=0.008
         (125 Hz) halves the solver iterations per sim-second vs the old 0.004,
         ~doubling RTF, and is still stable for these ≤1.3 m/s ground robots
         (1 cm/step << robot/​disc size, so inter-robot contact is still caught).
         Drop back to 0.004 if a collision test needs finer contact fidelity;
         throttle live via `gz service -s /world/poc_runway_world/set_physics`. -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>125</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>36.61002559225</latitude_deg>
      <longitude_deg>127.28772570583</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>200 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>2000</range>
        <constant>0.9</constant>
        <linear>0.001</linear>
        <quadratic>0.0001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Ground plane sized/aligned to the 400 x 26 runway (world == runway
         footprint). The <plane> COLLISION is infinite in gz regardless of
         <size> and stays at z=0 so robots rest on the runway top; only the
         VISUAL is bounded to 400 x 26 and tucked to z=-0.06 (inside the runway
         box z in [-0.1,0]) so it never z-fights the gray runway surface at
         z=0. Model centred at (200,0) so its x-edges coincide exactly with the
         runway ends (x=0 / x=400). -->
    <model name="ground_plane">
      <static>true</static>
      <pose>200 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 26</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.06 0 0 0</pose>
          <geometry><plane><normal>0 0 1</normal><size>400 26</size></plane></geometry>
          <material>
            <ambient>0.20 0.35 0.20 1</ambient>
            <diffuse>0.25 0.45 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Runway strip 400 x 26 (top at z=0) -->
    <model name="runway_surface">
      <static>true</static>
      <pose>200.0 0.0 -0.05 0 0 0</pose>
      <link name="link">
        <visual name="vis"><geometry><box><size>400.0 26.0 0.1</size></box></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obs_off">
        <static>true</static>
        <pose>30.0 1.5 1.0 0 0 0</pose>
        <link name="link"> 
          <collision name="col">
            <geometry><box><size>2.0 2.0 2.0</size></box></geometry>
          </collision>
          <visual name="vis">
            <geometry><box><size>2.0 2.0 2.0</size></box></geometry>
          </visual>
        </link>
      </model>

  </world>
</sdf>
